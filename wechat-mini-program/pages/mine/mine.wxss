/* 我的页面 - 样式文件 */

.page-container {
  padding: var(--spacing-md);
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部：用户信息卡片 */
.profile-card {
  background: linear-gradient(135deg, var(--primary-color) 0%, #1D4ED8 100%);
  border-radius: var(--radius-card);
  padding: var(--spacing-md);
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(37, 99, 235, 0.3);
  margin-bottom: var(--spacing-md);
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.profile-phone {
  display: block;
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.8);
}

.role-tag {
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-input);
  font-size: var(--font-size-xs);
  color: #fff;
  font-weight: 500;
}

/* 统计卡片 */
.stats-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-md);
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
  margin-bottom: var(--spacing-md);
}

.stats-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-item.tenant-only {
  flex-direction: column;
}

.stats-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 6rpx;
}

.stats-item.tenant-only .stats-value {
  font-size: var(--font-size-xxl);
}

.stats-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.stats-item.tenant-only .stats-label {
  margin-bottom: 8rpx;
}

.stats-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--border-color);
}

/* 功能菜单 */
.menu-section {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--border-light);
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-page);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-input);
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.menu-info {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: var(--font-size-base);
  color: var(--text-primary);
  font-weight: 500;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: var(--danger-color);
  color: #fff;
  font-size: var(--font-size-xs);
  border-radius: 18rpx;
  text-align: center;
  line-height: 36rpx;
  margin-right: var(--spacing-sm);
}

.menu-arrow {
  color: var(--text-placeholder);
  font-size: 36rpx;
  margin-left: var(--spacing-sm);
}

.logout-item {
  margin-top: var(--spacing-md);
}

.logout-item .menu-title {
  color: var(--danger-color);
  font-weight: 500;
}

.logout-item .menu-icon {
  background: #FEF2F2;
  color: var(--danger-color);
}
