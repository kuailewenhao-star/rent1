# ============================================
# 房东租赁管理系统 .gitignore
# 覆盖 Java/Maven + Vue/Vite + 微信小程序
# ============================================

# =====================
# Java/Maven 编译产物
# =====================
**/target/
**/build/
**/out/
**/.idea/
**/.settings/
**/.factorypath
**/.project
**/.classpath
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.iml
*.iws
*.ipr
hs_err_pid*
replay_pid*
*.log
*.ctxt
.mtj.tmp/
*.hprof
*.swp
*.swo
*~

# =====================
# Node.js / Vite / Vue
# =====================
node_modules/
**/node_modules/
dist/
**/dist/
.nuxt/
.next/
.nest/
.cache/
.parcel-cache/
.vite/
*.local
.env
.env.*.local

# Vue 类型检查构建产物
*.tsbuildinfo
tsconfig.tsbuildinfo

# Playwright / E2E 测试
playwright-report/
test-results/
.test-results/

# =====================
# 微信小程序
# =====================
project.private.config.json
project.config.user.json
miniprogram_npm/
.packedwxss/
unpackage/
unpackage.*
*.wxss.bak
*.wxss~
.wxml-temp/

# =====================
# IDE 和编辑器
# =====================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.sw?

# =====================
# 系统文件
# =====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =====================
# 日志与临时文件
# =====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# =====================
# 依赖锁（可选：如需统一版本可提交）
# =====================
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# =====================
# 本地开发配置
# =====================
*.local
*.dev
local/
private/
.private/

# =====================
# 备份文件
# =====================
*.bak
*.backup
*.old
*.orig

# =====================
# Docker / CI 临时产物
# =====================
.docker-data/
coverage/
.nyc_output/

# =====================
# 本地调试截图 / 脚本
# =====================
*.png
!app-home.png
screenshot*.png
debug*.png
*.ps1
!admin-web/scripts/*.ps1
!admin-web/scripts/*.sh
