/* 房东首页 - 样式文件 */

/* 角色切换提示 */
.role-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: var(--primary-light);
  border-radius: var(--radius-card);
  margin-bottom: var(--spacing-md);
}

.role-tip-text {
  font-size: var(--font-size-sm);
  color: var(--primary-color);
}

.role-tip-switch {
  font-size: var(--font-size-sm);
  color: var(--primary-dark);
  font-weight: 600;
}

/* 时间筛选器 */
.time-filter {
  padding: 0 0 var(--spacing-md) 0;
}

.time-filter-list {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.time-filter-item {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-input);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.time-filter-item.active {
  background: var(--primary-light);
  color: var(--primary-color);
  border-color: var(--primary-color);
}

/* 区块标题 */
.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
  padding-left: var(--spacing-xs);
}

/* 统计数据网格 */
.stats-grid {
  display: flex;
  gap: var(--spacing-sm);
}

.stats-grid-2 .stat-card {
  flex: 1;
}

.stats-grid-3 .stat-card {
  flex: 1;
}

.stats-grid-4 .stat-card {
  flex: 1;
  min-width: 0;
}

.stats-grid .stat-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-md);
  text-align: center;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease;
}

.stats-grid .stat-card:active {
  transform: scale(0.96);
}

.stats-grid .stat-card .stat-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stats-grid .stat-card .stat-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.stats-grid .stat-card.stat-card-primary .stat-value {
  color: var(--primary-color);
}

.stats-grid .stat-card.stat-card-success .stat-value {
  color: var(--accent-green);
}

.stats-grid .stat-card.stat-card-danger .stat-value {
  color: var(--accent-red);
}

.stats-grid .stat-card.stat-card-warning .stat-value {
  color: var(--accent-orange);
}

/* 盈利卡片 */
.profit-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
}

.profit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--border-light);
}

.profit-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-primary);
}

.profit-period {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.profit-content {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}

.profit-item {
  flex: 1;
}

.profit-label {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.profit-value {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.profit-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-color);
}

.profit-item-result {
  flex: 1.5;
  text-align: center;
}

.profit-item-result .profit-value {
  font-size: var(--font-size-xxl);
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-sm);
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-md) var(--spacing-sm);
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease;
}

.quick-action-item:active {
  transform: scale(0.95);
}

.quick-action-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-light);
  border-radius: 50%;
  color: var(--primary-color);
  font-size: var(--font-size-xl);
  font-weight: 300;
  margin-bottom: 10rpx;
}

.quick-action-text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

/* 消息入口 */
.message-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-md);
  margin-top: var(--spacing-md);
  box-shadow: var(--shadow-card);
  transition: background 0.2s ease;
}

.message-entry:active {
  background: var(--bg-hover);
}

.message-entry-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.message-icon {
  min-width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-red);
  color: #fff;
  font-size: var(--font-size-xs);
  border-radius: 50%;
  padding: 0 8rpx;
}

.message-title {
  font-size: var(--font-size-base);
  color: var(--text-primary);
}

/* 文字颜色工具类 */
.text-warning {
  color: var(--accent-orange);
}

.text-primary-color {
  color: var(--primary-color);
}
