<!--
  添加房源页面
  功能说明：创建新房源，支持整租/合租类型选择
  交互逻辑：选择房源类型后自动生成对应默认房间
  特殊业务限制：
    - 整租房源默认生成1间房间（整套）
    - 合租房源默认生成2间房间，最少保留2间不可删除
    - 房源创建后不可物理删除，仅做状态管控
-->
<view class="page-container">
  <form bindsubmit="onSubmit">
    <!-- 基本信息 -->
    <view class="form-section">
      <view class="form-section-title">基本信息</view>

      <!-- 房源名称 -->
      <view class="form-item">
        <view class="form-label required">房源名称</view>
        <input
          class="input"
          name="name"
          placeholder="请输入房源名称"
          value="{{formData.name}}"
          maxlength="50"
        />
      </view>

      <!-- 房源类型 -->
      <view class="form-item">
        <view class="form-label required">房源类型</view>
        <view class="type-selector">
          <view
            wx:for="{{propertyTypes}}"
            wx:key="id"
            class="type-option {{formData.type === item.id ? 'selected' : ''}}"
            bindtap="onTypeSelect"
            data-id="{{item.id}}"
          >
            <view class="type-icon">{{item.icon}}</view>
            <view class="type-name">{{item.name}}</view>
            <view class="type-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>

      <!-- 地址选择 -->
      <view class="form-item">
        <view class="form-label required">房源地址</view>
        <view class="address-picker">
          <picker
            mode="region"
            bindchange="onRegionChange"
            value="{{region}}"
          >
            <view class="picker-value {{region.length === 0 ? 'placeholder' : ''}}">
              {{region.length > 0 ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
            </view>
          </picker>
        </view>

        <input
          class="input mt-sm"
          name="address"
          placeholder="请输入详细楼栋单元门牌号"
          value="{{formData.address}}"
          maxlength="100"
        />
      </view>

      <!-- 总户型 -->
      <view class="form-item">
        <view class="form-label">总户型</view>
        <input
          class="input"
          name="layout"
          placeholder="如：3室2厅2卫"
          value="{{formData.layout}}"
          maxlength="20"
        />
      </view>
    </view>

    <!-- 承租信息 -->
    <view class="form-section">
      <view class="form-section-title">承租信息</view>

      <!-- 承租开始时间 -->
      <view class="form-item">
        <view class="form-label required">承租开始时间</view>
        <picker
          mode="date"
          bindchange="onRentStartChange"
          value="{{formData.rentStartDate}}"
          start="2000-01-01"
        >
          <view class="picker-value {{formData.rentStartDate ? '' : 'placeholder'}}">
            {{formData.rentStartDate || '请选择承租开始时间'}}
          </view>
        </picker>
      </view>

      <!-- 承租结束时间 -->
      <view class="form-item">
        <view class="form-label required">承租结束时间</view>
        <picker
          mode="date"
          bindchange="onRentEndChange"
          value="{{formData.rentEndDate}}"
          start="{{formData.rentStartDate || '2000-01-01'}}"
        >
          <view class="picker-value {{formData.rentEndDate ? '' : 'placeholder'}}">
            {{formData.rentEndDate || '请选择承租结束时间'}}
          </view>
        </picker>
      </view>
    </view>

    <!-- 房间预览提示 -->
    <view class="form-section" wx:if="{{formData.type}}">
      <view class="form-section-title">将自动创建的房间</view>
      <view class="room-preview">
        <view class="room-preview-item" wx:if="{{formData.type === 'whole'}}">
          <text class="room-name">整套</text>
          <text class="room-tip">整租默认房间</text>
        </view>
        <view class="room-preview-item" wx:if="{{formData.type === 'shared'}}">
          <text class="room-name">房间1</text>
          <text class="room-tip">合租默认房间</text>
        </view>
        <view class="room-preview-item" wx:if="{{formData.type === 'shared'}}">
          <text class="room-name">房间2</text>
          <text class="room-tip">合租默认房间</text>
        </view>
        <view class="room-preview-tip">
          <text class="tip-icon">i</text>
          <text class="tip-text">合租房源最少保留2间房间，创建后可新增更多房间</text>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="form-actions">
      <button
        class="btn btn-primary btn-block"
        form-type="submit"
        disabled="{{!canSubmit}}"
      >
        创建房源
      </button>
    </view>
  </form>
</view>
