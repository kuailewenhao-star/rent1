<!--
  我的页面（个人中心）
  - 房东端：完整功能 + 角色切换入口
  - 租客端：仅展示本人基础信息
-->
<view class="page-container">

  <!-- 顶部：用户信息卡片 -->
  <view class="profile-card">
    <view class="profile-avatar">
      <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-text">{{userInfo.name[0]}}</text>
    </view>
    <view class="profile-info">
      <text class="profile-name">{{userInfo.name}}</text>
      <text class="profile-phone">{{userInfo.phone}}</text>
    </view>
    <view class="role-tag">
      <text>{{currentRole === 'landlord' ? '房东' : '租客'}}</text>
    </view>
  </view>

  <!-- 房东专属：房源/房间/合约 概览 -->
  <view class="stats-card" wx:if="{{currentRole === 'landlord'}}">
    <view class="stats-item" bindtap="goToProperties">
      <text class="stats-value">{{landlordStats.properties}}</text>
      <text class="stats-label">房源</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="goToRooms">
      <text class="stats-value">{{landlordStats.rooms}}</text>
      <text class="stats-label">房间</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="goToContracts">
      <text class="stats-value">{{landlordStats.contracts}}</text>
      <text class="stats-label">合约</text>
    </view>
  </view>

  <!-- 租客专属：押金信息 -->
  <view class="stats-card" wx:if="{{currentRole === 'tenant'}}">
    <view class="stats-item tenant-only">
      <text class="stats-label">当前有效押金</text>
      <text class="stats-value">¥{{tenantDeposit}}</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <!-- 房东/租客通用：消息 -->
    <view class="menu-item" bindtap="goToMessages">
      <view class="menu-icon">
        <text>🔔</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">消息提醒</text>
      </view>
      <view class="menu-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 租客专属：我的押金 -->
    <view class="menu-item" wx:if="{{currentRole === 'tenant'}}" bindtap="goToDeposit">
      <view class="menu-icon">
        <text>💰</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">我的押金</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 租客专属：联系房东 -->
    <view class="menu-item" wx:if="{{currentRole === 'tenant'}}" bindtap="goToContact">
      <view class="menu-icon">
        <text>📞</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">联系房东</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 角色切换（仅多角色用户） -->
    <block wx:if="{{hasMultipleRoles}}">
      <view class="menu-item" wx:if="{{currentRole === 'landlord'}}" bindtap="switchToTenant">
        <view class="menu-icon">
          <text>🏢</text>
        </view>
        <view class="menu-info">
          <text class="menu-title">切换到租客身份</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" wx:if="{{currentRole === 'tenant'}}" bindtap="switchToLandlord">
        <view class="menu-icon">
          <text>🏠</text>
        </view>
        <view class="menu-info">
          <text class="menu-title">切换到房东身份</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </block>

    <!-- 退出登录 -->
    <view class="menu-item logout-item" bindtap="onLogout">
      <view class="menu-icon">
        <text>🚪</text>
      </view>
      <view class="menu-info">
        <text class="menu-title">退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
